              "type": "string"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CatalogListResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CatalogSummary"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CatalogSummary": {
        "type": "object",
        "properties": {
          "recipeId": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "format": "int32"
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "cuisine": {
            "type": "string",
            "nullable": true
          },
          "difficulty": {
            "type": "string",
            "nullable": true
          },
          "previewText": {
            "type": "string",
            "nullable": true
          },
          "isFree": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "CommentCreatedResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "CommentListResponse": {
        "type": "object",
        "properties": {
          "comments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecipeComment"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CommentRequest": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CommentStatus": {
        "enum": [
          0,
          1
        ],
        "type": "integer",
        "format": "int32"
      },
      "CreateDraftRequest": {
        "type": "object",
        "properties": {
          "content": {
            "$ref": "#/components/schemas/RecipeContent"
          },
          "provenance": {
            "$ref": "#/components/schemas/ProvenanceEvidence"
          },
          "isFree": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "IngredientLine": {
        "required": [
          "name",
          "quantity"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "quantity": {
            "$ref": "#/components/schemas/Quantity"
          },
          "substitution": {
            "$ref": "#/components/schemas/Substitution"
          }
        },
        "additionalProperties": false
      },
      "LoginEndpointRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "nullable": true
          },
          "expiresAtUtc": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "PaymentMethodsResponse": {
        "type": "object",
        "properties": {
          "allowed": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ProvenanceEvidence": {
        "required": [
          "sourceNote"
        ],
        "type": "object",
        "properties": {
          "originalTextAttested": {
            "type": "boolean"
          },
          "originalPhotographyAttested": {
            "type": "boolean"
          },
          "sourceNote": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Quantity": {
        "required": [
          "unit",
          "value"
        ],
        "type": "object",
        "properties": {
          "value": {
            "type": "number",
            "format": "double"
          },
          "unit": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ReasonCodeRequest": {
        "type": "object",
        "properties": {
          "reasonCode": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "RecipeComment": {
        "required": [
          "recipeId",
          "text",
          "userId"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "recipeId": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "text": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "$ref": "#/components/schemas/CommentStatus"
          },
          "moderationReason": {
            "type": "string",
            "nullable": true
          },
          "createdAtUtc": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "RecipeContent": {
        "required": [
          "cuisine",
          "culturalContext",
          "difficulty",
          "equipment",
          "ingredients",
          "instructions",
          "previewText",
          "title"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "nullable": true
          },
          "cuisine": {
            "type": "string",
            "nullable": true
          },
          "difficulty": {
            "type": "string",
            "nullable": true
          },
          "previewText": {
            "type": "string",
            "nullable": true
          },
          "ingredients": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IngredientLine"
            },
            "nullable": true
          },
          "instructions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "equipment": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "culturalContext": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "RegisterEndpointRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "declaredCountryCode": {
            "type": "string",
            "nullable": true
          },
          "agreementVersionAccepted": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "RegisterResponse": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "Substitution": {
        "required": [
          "item"
        ],
        "type": "object",
        "properties": {
          "item": {
            "type": "string",
            "nullable": true
          },
          "asianGroceryOnly": {
            "type": "boolean"
          },
          "note": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Paste the JWT from /api/auth/login.",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    }
  ]
}