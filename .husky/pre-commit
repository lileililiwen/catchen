#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Git hooks do not inherit a login shell's PATH; resolve the user-local
# toolchains explicitly (kept in sync with ~/.bash_profile).
export PATH="$HOME/flutter/bin:$HOME/.dotnet:$PATH"

# Fast local format check on staged files only.
# CI (dotnet format / dart format on the whole tree) is the authoritative
# gate; this hook gives instant feedback before commit. Both checks no-op
# until the backend solution / client workspace scaffolds exist.
# NOTE: husky re-runs hooks with `sh -e`; every probe command must be
# failure-proof so an absent scaffold cannot abort the hook.

sln=$(find . -maxdepth 3 -name '*.sln' -not -path './clients/*' 2>/dev/null | head -n 1)
staged_cs=$(git diff --cached --name-only --diff-filter=ACM -- '*.cs')
if [ -n "$sln" ] && [ -n "$staged_cs" ]; then
  dotnet format "$sln" --verify-no-changes --no-restore --include $staged_cs || exit 1
fi

client_pubspec=$(find . -maxdepth 3 -name pubspec.yaml -not -path '*/build/*' 2>/dev/null | head -n 1) || true
staged_dart=$(git diff --cached --name-only --diff-filter=ACM -- '*.dart')
if [ -n "$client_pubspec" ] && [ -n "$staged_dart" ]; then
  # Paths stay repo-root-relative; dart format resolves them from here.
  dart format --set-exit-if-changed --output=none $staged_dart || exit 1
fi

exit 0
