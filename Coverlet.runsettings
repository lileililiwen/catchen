<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <!-- Coverage configuration for the dotnet test XPlat coverage collector.
       OpenCover XML is consumed by scripts/check_incremental_coverage.py
       (coverage-gates capability). -->
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>opencover</Format>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
